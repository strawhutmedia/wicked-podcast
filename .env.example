# Instagram API Configuration
# Get your access token from the Facebook Developer Portal
# See README.md for detailed setup instructions
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here

# Server Configuration
PORT=3000

# Number of posts to fetch (max 25)
POST_LIMIT=12

# Optional: Restrict CORS to specific domains (comma-separated)
# Leave empty or remove to allow all origins
ALLOWED_ORIGINS=https://strawhutmedia.com,https://www.strawhutmedia.com

# Admin API key for manual refresh endpoint
# Generate a secure random string
ADMIN_API_KEY=your_secure_api_key_here
